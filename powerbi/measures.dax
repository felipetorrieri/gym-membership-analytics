Total Members = DISTINCTCOUNT(members[member_id])
Active Members = CALCULATE(DISTINCTCOUNT(members[member_id]), members[status] = "Active")
Cancelled Members = CALCULATE(DISTINCTCOUNT(members[member_id]), members[status] = "Cancelled")
MRR = SUM(monthly_membership[recognized_revenue])
Average Ticket = DIVIDE([MRR], DISTINCTCOUNT(monthly_membership[member_id]))
Delinquent Members = CALCULATE(DISTINCTCOUNT(monthly_membership[member_id]), monthly_membership[is_delinquent] = 1)
Delinquency Rate = DIVIDE([Delinquent Members], DISTINCTCOUNT(monthly_membership[member_id]))
Total Visits = COUNTROWS(visits)
Unique Visitors = DISTINCTCOUNT(visits[member_id])
Visits per Member = DIVIDE([Total Visits], [Unique Visitors])
Average Tenure (Months) = AVERAGE(members[tenure_months])
Cancellation Rate = DIVIDE([Cancelled Members], [Total Members])
